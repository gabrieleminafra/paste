DATABASE_URL=postgres://pastebin:pastebin@localhost:5432/pastebin
PORT=3000
NODE_ENV=development
# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Directory for uploaded files. Defaults to <repo>/uploads when unset.
# UPLOAD_DIR=./uploads
# Retention windows in days, after which content is considered expired.
PASTE_TTL_DAYS=30
FILE_TTL_DAYS=7
